{
  "name": "@vrata/presentation-room-v1",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-baked-review.mjs",
    "build:release": "node scripts/build-baked-review.mjs",
    "bake:review": "node scripts/build-baked-review.mjs --bake",
    "materialize:release": "node scripts/build-baked-review.mjs --materialize",
    "rematerialize:release": "node scripts/build-baked-review.mjs --materialize --replace-materialized",
    "validate:visual": "node scripts/validate-visual-parity.mjs",
    "test": "node --test tests/review-release.test.mjs",
    "validate": "node scripts/validate-review-repository.mjs",
    "inspect": "node scripts/inspect-release.mjs",
    "verify:reproducibility": "node scripts/verify-review-reproducibility.mjs",
    "verify:baked-blender": "node scripts/build-baked-review.mjs --twice",
    "verify:historical-blender": "node scripts/verify-reproducibility.mjs"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.4.2",
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "sharp": "0.34.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
