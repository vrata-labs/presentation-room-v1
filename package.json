{
  "name": "@vrata/presentation-room-v1",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-release-0.4.mjs",
    "build:release": "node scripts/build-release-0.4.mjs",
    "author:release": "node scripts/build-release.mjs --author",
    "reauthor:release": "node scripts/build-release.mjs --author --replace-untracked",
    "bake:review": "node scripts/build-release.mjs --bake",
    "rebake:review": "node scripts/build-release.mjs --bake --replace-untracked",
    "materialize:release": "node scripts/materialize-release-0.4.mjs",
    "rematerialize:release": "node scripts/materialize-release-0.4.mjs --replace-untracked",
    "validate:visual": "node scripts/validate-release-0.4.mjs --visual-only",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-release-0.4.mjs",
    "inspect": "node scripts/inspect-release.mjs",
    "verify:reproducibility": "node scripts/verify-release-0.4-reproducibility.mjs",
    "verify:baked-blender": "node scripts/build-release.mjs --twice",
    "verify:historical-blender": "node scripts/verify-reproducibility.mjs",
    "verify:historical-0.3": "node scripts/verify-release-0.3-reproducibility.mjs"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.4.2",
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.0.1",
    "sharp": "0.34.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
