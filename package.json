{
  "name": "@vrata/presentation-room-v1",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/materialize-review-release-0.4.1.mjs",
    "build:release": "node scripts/materialize-review-release-0.4.1.mjs",
    "preview:review": "node scripts/rework-preview-0.4.1.mjs",
    "author:release": "node scripts/build-release.mjs --author",
    "reauthor:release": "node scripts/build-release.mjs --author --replace-untracked",
    "bake:review": "node scripts/build-release.mjs --bake",
    "rebake:review": "node scripts/build-release.mjs --bake --replace-untracked",
    "materialize:release": "node scripts/materialize-review-release-0.4.1.mjs",
    "rematerialize:release": "node scripts/materialize-review-release-0.4.1.mjs",
    "validate:visual": "node source/releases/0.4.1/validate-review.mjs && node scripts/historical-check.mjs validate:visual",
    "test": "node scripts/historical-check.mjs test && node --test tests/immutability-workflow.test.mjs tests/release-0.4.1.test.mjs",
    "validate": "node source/releases/0.4.1/validate-review.mjs && node scripts/historical-check.mjs validate",
    "inspect": "gltf-transform inspect assets/scenes/presentation-room-v1/0.4.1/scene.glb",
    "verify:reproducibility": "node scripts/historical-check.mjs verify:reproducibility && node source/releases/0.4.1/verify-reproducibility.mjs",
    "verify:baked-blender": "node scripts/build-release.mjs --twice",
    "verify:historical-blender": "node scripts/verify-reproducibility.mjs",
    "verify:historical-0.3": "node scripts/verify-release-0.3-reproducibility.mjs"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.4.2",
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.0.1",
    "sharp": "0.34.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
